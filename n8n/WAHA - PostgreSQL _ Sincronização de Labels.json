      "id": "f2da85d7-5930-4e86-98a0-c4449f38c40c",
      "name": "Sincronizar a cada 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -688,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const chat = item.json;\n\n  return {\n    json: {\n      chat_id: chat.id?._serialized ?? null,\n      name: chat.name ?? null,\n      label_id: chat.label_id ?? null\n    }\n  };\n});"
      },
      "id": "a2956f85-b385-471a-8c88-a989d10622f4",
      "name": "Normalizar contatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        192
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst unique = new Map();\n\nfor (const item of items) {\n  const chatId = item.json.chat_id;\n  if (!chatId) continue;\n\n  const key = `${chatId}|${item.json.label_id}`;\n\n  unique.set(key, {\n    json: {\n      chat_id: chatId,\n      name: item.json.name ?? null,\n      label_id: item.json.label_id\n    }\n  });\n}\n\nreturn [...unique.values()];"
      },
      "id": "337b9078-1098-4296-966c-7cfcfed19bcb",
      "name": "Remover duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contacts (\n  chat_id,\n  name,\n  updated_at\n)\nVALUES (\n  $1,\n  $2,\n  NOW()\n)\nON CONFLICT (chat_id)\nDO UPDATE SET\n  name = COALESCE(EXCLUDED.name, contacts.name),\n  updated_at = NOW();\n\nINSERT INTO contact_history (\n  chat_id,\n  name,\n  label_id,\n  observed_at\n)\nVALUES (\n  $1,\n  $2,\n  $3,\n  NOW()\n);",
        "options": {
          "queryReplacement": "={{ [$json.chat_id, $json.name, $json.label_id] }}"
        }
      },
